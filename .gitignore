# ==========================================
# CareerCast - Git Ignore Rules
# ==========================================

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
streamlit_app/venv/

# --- Environment Variables & Secrets ---
.env
.env.*
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!.env.example

# --- Machine Learning & MLFlow ---
mlruns/
.mlflow/
*.checkpoint

# --- Large Datasets & User Uploads ---
datasets/*
!datasets/.gitkeep
uploads/*
!uploads/.gitkeep
*.pdf
*.docx
*.doc

# --- Node.js & React Frontend ---
node_modules/
frontend/node_modules/
frontend/build/
build/
dist/
.npm
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Databases & SQLite ---
*.db
*.sqlite
*.sqlite3
careercast.db
backend/careercast.db

# --- Logs & Scratch Files ---
*.log
scratch/
.tmp/
.cache/

# --- OS & IDE Caches ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
