# Python Caches & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Large Datasets & Raw CSV Files (>50MB/100MB)
datasets/*
!datasets/.gitkeep

# User Uploaded Resume Files
uploads/*
!uploads/.gitkeep
*.pdf
*.docx
*.doc

# Node.js & React Build Dependencies
node_modules/
frontend/node_modules/
frontend/build/
build/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database & Storage Files
*.db
*.sqlite
*.sqlite3
careercast.db

# Logs & Temporary Scratch Files
*.log
scratch/
.tmp/

# OS & IDE Caches
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
